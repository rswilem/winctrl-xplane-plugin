# Shared Linux build image for the X-Plane plugins. Keep this file identical
# across all of them: one base means one glibc floor and one layer cache.
#
# Ubuntu 22.04 is glibc 2.35. That number is the whole point: the build host's
# glibc becomes the oldest system the shipped .xpl will load on. Building on a
# newer base pulls in symbols like __isoc23_strtol (glibc 2.38+) and the plugin
# then dies with "dlerror: undefined symbol" on older distros. That is winctrl
# issue #33, where debian:stable silently rolled to Debian 13 and broke it.
# 2.35 is lower than Debian 12's 2.36, so this is the widest reach of the three
# bases we have used.
#
# Do NOT move to ubuntu:24.04 (glibc 2.39) or debian:13 (2.41).
#
# The toolchain PPA is here only to get g++-13: jammy stocks g++-11, and
# boarderline's sources use std::format, which needs GCC 13 or newer.
FROM --platform=linux/amd64 ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends software-properties-common gpg-agent && \
    add-apt-repository -y ppa:ubuntu-toolchain-r/test && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        g++-13 \
        make \
        cmake \
        libgl-dev \
        libssl-dev \
        libcurl4-openssl-dev \
        libudev-dev \
        libusb-1.0-0-dev \
        pkg-config \
        binutils \
        zip && \
    apt-get purge -y software-properties-common gpg-agent && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

# toolchain-lin.cmake hardcodes gcc/g++, so point those at 13 here rather than
# editing the toolchain file in every repo.
RUN update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-13 100 && \
    update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-13 100

WORKDIR /workspace

CMD ["/bin/bash"]
